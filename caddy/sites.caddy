# Reverse proxy routes — spec §5.2.
#
# Shared by both the production and dev Caddyfiles so the two can never drift.
# The only difference between environments is CADDY_DOMAIN and how certificates
# are issued; the routing is identical.
#
#   production   CADDY_DOMAIN=<host>.ts.net   certs from the local tailscaled
#   development  CADDY_DOMAIN=localhost       certs from Caddy's internal CA
#
# Upstreams are container names on the compose bridge network, so these must
# stay in step with `container_name` in docker-compose.yml.

# Every site imports `common` — access logging plus baseline security headers.
# It is defined in Caddyfile and Caddyfile.dev rather than here, because the two
# environments need different headers: HSTS is right on the tailnet and wrong on
# localhost, where it would pin every *.localhost host to HTTPS in the browser
# for a year and break unrelated local work. Routing stays shared; anything that
# legitimately differs per environment lives in the two Caddyfiles, same as
# certificate issuance already does.

# The front door. Static files, served by this same Caddy — no extra container.
# Links inside the page are derived from location.host at runtime, so the one
# file works at both <host>.ts.net and localhost:8443 without templating.
{$CADDY_DOMAIN} {
	import common
	root * /srv/site
	file_server
}

jellyfin.{$CADDY_DOMAIN} {
	import common
	reverse_proxy jellyfin:8096
}

# Requests — where everyone who is not the administrator should start.
seerr.{$CADDY_DOMAIN} {
	import common
	reverse_proxy jellyseerr:5055
}

sonarr.{$CADDY_DOMAIN} {
	import common
	reverse_proxy sonarr:8989
}

radarr.{$CADDY_DOMAIN} {
	import common
	reverse_proxy radarr:7878
}

prowlarr.{$CADDY_DOMAIN} {
	import common
	reverse_proxy prowlarr:9696
}

bazarr.{$CADDY_DOMAIN} {
	import common
	reverse_proxy bazarr:6767
}

qbit.{$CADDY_DOMAIN} {
	import common
	reverse_proxy qbittorrent:8080
}

sab.{$CADDY_DOMAIN} {
	import common
	reverse_proxy sabnzbd:8080
}
