# Secrets — never commit
.env
.env.local
*.key
*.pem
secrets/

# Runtime state. Container config lives outside the repo, at CONFIG_ROOT
# (/opt/mediaserver), so nothing should land here — these are a safety net for
# a mistyped DATA_ROOT or CONFIG_ROOT pointing inside the working tree.
/data/
/appdata/
/dev/
#
# NOTE: config/ is deliberately NOT ignored — config/recyclarr/recyclarr.yml is
# version-controlled and mounted read-only into the container.

# Editor / OS noise
.DS_Store
.vscode/
.idea/
*.swp

# Scratch
*.log
tmp/
